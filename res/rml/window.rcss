/*
 * Mario Party 5 look: purple message-window panels with a thick cream rim,
 * orange title-banner pills, yellow focus with a star cursor, chunky rounded type (Fredoka).
 * Palette: deep purple #24104a / #361769 / #5b2fb0, cream #fff3d0, banner #ffe9a8 > #f6bd5c > #e48a2a,
 * banner rim #8a3f08, highlight #fff59a > #ffc21e > #ff9d14, text on highlight #4a1c00.
 */

*, *:before, *:after {
    box-sizing: border-box;
}

body {
    display: flex;
    width: 100%;
    height: 100%;
    padding: 64dp;
    font-family: "Fredoka";
    font-weight: 500;
    font-style: normal;
    font-size: 12dp;
    color: #FFF8E6;
    /* dimmed backdrop with a faint star pattern */
    background-color: rgba(14, 4, 34, 55%);
    decorator: image(../ui-stars-tile.png repeat);
}

window {
    display: flex;
    flex-flow: column;
    position: relative;
    height: 100%;
    width: 100%;
    max-width: 1088dp;
    max-height: 768dp;
    margin: auto;
    border-radius: 30dp;
    overflow: hidden;
    border: 4dp #FFF3D0;
    backdrop-filter: blur(5dp);
    box-shadow: #1A0838 0 0 0 4dp, rgba(0, 0, 0, 55%) 0 12dp 32dp 0dp;
    background-color: #2E1460;
    decorator: image(../ui-stars-tile.png repeat), linear-gradient(180deg, rgba(104, 58, 196, 94%) 0%, rgba(54, 23, 105, 94%) 45%, rgba(36, 16, 74, 96%) 100%);
    filter: opacity(0);
    transform: scale(0.8);
    transform-origin: center;
    transition: filter 0.18s cubic-out, transform 0.38s back-out;
}

window.small {
    height: auto;
    width: auto;
}

window.modal {
    max-width: 640dp;
}

window[open] {
    filter: opacity(1);
    transform: scale(1);
}

@media (max-height: 640dp) {
    body {
        padding: 16dp;
    }
    window {
        box-shadow: #1A0838 0 0 0 3dp;
    }
}

window tab-bar {
    flex: 0 0 68dp;
    height: 68dp;
    padding: 0 10dp;
    background-color: rgba(20, 6, 48, 55%);
    font-family: "Fredoka";
    font-weight: bold;
    font-size: 17dp;
    border-bottom: 4dp #FFF3D0;
}

window content {
    display: flex;
    flex: 1 1 auto;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

window content pane {
    display: flex;
    flex-flow: column;
    flex: 1 1 0;
    min-width: 0;
    min-height: 0;
    padding: 24dp;
    padding-bottom: 0dp;
    gap: 8dp;
    overflow: hidden auto;
    font-size: 16dp;
}

window content pane:not(:last-of-type) {
    border-right: 3dp rgba(216, 205, 245, 22%);
}

window content pane > * {
    flex: 0 0 auto;
}

window content pane:last-of-type > div {
    line-height: 1.625;
    color: #F1EAFF;
}

window content pane > spacer {
    display: block;
    /* Completes the 24dp bottom inset after the pane's 8dp gap. */
    flex: 0 0 16dp;
    height: 16dp;
    pointer-events: none;
}

scrollbarvertical {
    width: 10dp;
    margin: 6dp 6dp 6dp 0;
}

scrollbarvertical sliderarrowdec,
scrollbarvertical sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarvertical slidertrack {
    width: 10dp;
    border-radius: 5dp;
    background-color: rgba(255, 255, 255, 8%);
}

scrollbarvertical sliderbar {
    width: 10dp;
    min-height: 24dp;
    border-radius: 5dp;
    background-color: rgba(255, 210, 63, 70%);
    transition: background-color 0.2s cubic-in-out;
}

scrollbarvertical sliderbar:hover,
scrollbarvertical sliderbar:active {
    background-color: #FFD23F;
}

scrollbarhorizontal {
    height: 0;
}

scrollbarhorizontal sliderarrowdec,
scrollbarhorizontal sliderarrowinc {
    width: 0;
    height: 0;
}

scrollbarhorizontal slidertrack,
scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

/* Orange title-banner pill, like MP5's "Party Mode" / "Options Mode" headers */
.section-heading {
    align-self: flex-start;
    padding: 1dp 18dp 3dp 18dp;
    border-radius: 16dp;
    border: 3dp #8A3F08;
    decorator: linear-gradient(180deg, #FFEDB5 0%, #F6BD5C 55%, #E48A2A 100%);
    font-family: "Fredoka";
    font-weight: bold;
    text-transform: uppercase;
    font-size: 16dp;
    color: #FFFFFF;
    font-effect: outline(2dp #8A3F08);
}

.section-heading:not(:first-of-type) {
    margin-top: 12dp;
}

/* Pill buttons. The left padding leaves room for the star cursor shown on focus. */
button,
select-button {
    background-color: rgba(255, 255, 255, 9%);
    border: 3dp rgba(216, 205, 245, 30%);
    border-radius: 22dp;
    font-size: 16dp;
    transform: scale(1);
    transition: transform 0.22s back-out, background-color 0.1s linear-in-out;
    cursor: pointer;
    focus: auto;
}

button {
    text-align: center;
    padding: 7dp 40dp;
}

select-button {
    display: flex;
    align-items: center;
    gap: 8dp;
    padding: 7dp 18dp 7dp 40dp;
}

button:not(:disabled):hover,
button:not(:disabled):focus-visible,
select-button:not(:disabled):hover,
select-button:not(:disabled):focus-visible {
    color: #4A1C00;
    border-color: #FFFFFF;
    decorator: image(../ui-cursor.png contain 6px center), linear-gradient(180deg, #FFF8B0 0%, #FFD23A 55%, #FFA51E 100%);
    box-shadow: rgba(255, 200, 40, 60%) 0 0 14dp 2dp;
    transform: scale(1.03);
}

button:not(:disabled):selected,
select-button:not(:disabled):selected {
    border-color: #FFC94A;
    background-color: rgba(255, 170, 40, 30%);
}

button:not(:disabled):active,
select-button:not(:disabled):active {
    color: #4A1C00;
    border-color: #FFFFFF;
    decorator: image(../ui-cursor.png contain 6px center), linear-gradient(180deg, #FFD23A 0%, #FF9D14 100%);
    transform: scale(0.98);
}

button:disabled,
select-button:disabled {
    opacity: 0.4;
    cursor: default;
}

button.modal-btn {
    flex: 1 1 0;
    text-align: center;
}

select-button key {
    font-family: "Fredoka";
    font-weight: 600;
    font-size: 15dp;
    text-transform: uppercase;
    flex: 0 1 auto;
}

select-button value {
    flex: 1 1 auto;
    text-align: right;
    font-size: 16dp;
    color: #FFE066;
}

select-button:not(:disabled):hover value,
select-button:not(:disabled):focus-visible value,
select-button:not(:disabled):active value {
    color: #8A2E00;
}

select-button value.modified {
    font-weight: bold;
}

select-button input {
    text-align: right;
    font-size: 16dp;
}

icon {
    width: 1em;
    height: 1em;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
}

icon.warning {
    decorator: text("&#xe002;" center center);
}

icon.error {
    decorator: text("&#xe000;" center center);
}

icon.verifying {
    decorator: text("&#xe8b5;" center center);
}

icon.celebration {
    decorator: text("&#xea65;" center center);
}

icon.question-mark {
    decorator: text("&#xeb8b;" center center);
}

.achievement-total {
    position: absolute;
    top: 0;
    right: 68dp;
    height: 68dp;
    line-height: 68dp;
    font-family: "Fredoka";
    font-weight: bold;
    font-size: 15dp;
    color: #FFE066;
    pointer-events: none;
}

.achievement-row {
    display: flex;
    align-items: flex-start;
    gap: 10dp;
    padding: 12dp 0;
    border-bottom: 2dp rgba(216, 205, 245, 18%);
}

.achievement-info {
    display: block;
    flex: 1 1 0;
    min-width: 0;
}

.achievement-header {
    display: flex;
    align-items: center;
}

.achievement-name {
    flex: 1;
    font-weight: bold;
}

.achievement-name.unlocked {
    color: #FFD23F;
}

.achievement-badge {
    font-size: 14dp;
    opacity: 0.7;
}

.achievement-badge.unlocked {
    color: #7BE36A;
    opacity: 1;
}

.achievement-badge.locked {
    color: #FF7A7A;
    opacity: 1;
}

.achievement-desc {
    display: block;
    color: rgba(241, 234, 255, 70%);
    font-size: 16dp;
    margin: 4dp 0 0 0;
}

.achievement-progress {
    display: block;
    font-size: 13dp;
    color: rgba(241, 234, 255, 60%);
}

progress {
    display: block;
    width: 100%;
    height: 8dp;
    border-radius: 4dp;
    background-color: rgba(255, 255, 255, 12%);
    margin: 6dp 0 2dp 0;
}

progress.progress-done fill {
    background-color: #5FD35A;
    border-radius: 4dp;
}

progress.progress-ongoing fill {
    background-color: #FFB52E;
    border-radius: 4dp;
}

button.achievement-clear {
    flex: 0 0 auto;
    align-self: center;
    font-size: 14dp;
    padding: 2dp 12dp 2dp 30dp;
    opacity: 0.6;
}

.preset-grid {
    display: flex;
    flex-direction: row;
    gap: 20dp;
    flex: 0 1 auto;
    align-items: flex-start;
    width: 100%;
}

.preset-col {
    display: flex;
    flex-flow: column;
    gap: 12dp;
    flex: 1 1 0;
}

.preset-desc {
    display: block;
    font-size: 16dp;
    text-align: center;
}

.modal-dialog {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 24dp;
    gap: 20dp;
    flex: 0 1 auto;
    width: 100%;
    text-align: left;
}

window.modal.danger {
    border-color: #FF8A8A;
    box-shadow: #5A0C14 0 0 0 4dp, rgba(0, 0, 0, 55%) 0 12dp 32dp 0dp;
}

.modal-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    flex: 0 0 auto;
    gap: 16dp;
}

.modal-header icon {
    font-size: 26dp;
    color: #FFD23F;
}

.modal-title {
    display: block;
    font-family: "Fredoka";
    font-weight: bold;
    text-transform: uppercase;
    font-size: 19dp;
    color: #FFD23F;
    font-effect: outline(2dp #4A1C00);
    flex: 1 1 auto;
}

window.modal.danger .modal-title,
window.modal.danger .modal-header icon {
    color: #FF7A7A;
}

.modal-body {
    display: block;
    width: 100%;
    flex: 0 1 auto;
    min-width: 0;
    font-size: 16dp;
    color: #FFFFFF;
    font-weight: 500;
}

.modal-body span.tip {
    font-size: 14dp;
    color: #FFE066;
}

.verification-progress {
    display: flex;
    flex-direction: column;
    gap: 10dp;
    width: 100%;
}

.verification-file {
    display: block;
    font-size: 17dp;
    color: #FFFFFF;
}

progress.verification-progress-bar {
    height: 10dp;
    margin: 2dp 0 0 0;
}

.verification-detail {
    display: block;
    font-size: 14dp;
    color: rgba(241, 234, 255, 70%);
}

.modal-actions {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap;
    align-items: stretch;
    gap: 12dp;
    width: 100%;
    flex: 0 0 auto;
    padding-top: 4dp;
}
