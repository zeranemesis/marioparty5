*, *:before, *:after {
    box-sizing: border-box;
}

body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "Fredoka";
    font-weight: bold;
    font-size: 18dp;
    color: #FFF8E6;
}

button {
    cursor: pointer;
    focus: auto;
}

/* Purple MP5 message-window bar hanging from the top edge, cream rim, rounded bottom corners */
popup {
    display: flex;
    align-items: stretch;
    height: 68dp;
    margin: 0 24dp;
    padding: 0 8dp;
    border-width: 0dp 4dp 4dp 4dp;
    border-color: #FFF3D0;
    border-radius: 0dp 0dp 28dp 28dp;
    background-color: #2E1460;
    decorator: image(../ui-stars-tile.png repeat), linear-gradient(180deg, #24104A 0%, #361769 50%, #5B2FB0 100%);
    box-shadow: #1A0838 0 0 0 3dp, rgba(0, 0, 0, 45%) 0 8dp 20dp 0dp;
    transform: translateY(-80dp);
    transition: transform 0.3s back-out;
}

popup[open] {
    transform: translateY(0);
}

popup tab-bar {
    flex: 1 1 0;
}
