*, *:before, *:after {
    box-sizing: border-box;
}

body {
    overflow: visible;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-family: "Fredoka";
    font-size: 20dp;
    color: #FFFFFF;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
}

.tuner-root {
    width: 100%;
    min-height: 45%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: stretch;
    padding: 0 32dp;
    decorator: vertical-gradient(#1A083800 #1A0838A0);
    filter: opacity(0);
    transition: filter 0.2s linear-in-out;
}

.tuner-root[open] {
    filter: opacity(1);
}

.tuner {
    width: 100%;
    max-width: 1216dp;
    margin-left: auto;
    margin-right: auto;
    display: flex;
    flex-direction: column;
    gap: 24dp;
    padding: 32dp 48dp;
    /* MP5 purple message window, kept compact so the game preview stays visible */
    margin-bottom: 32dp;
    border: 4dp #FFF3D0;
    border-radius: 30dp;
    box-shadow: #1A0838 0 0 0 4dp, rgba(0, 0, 0, 50%) 0 8dp 24dp 0dp;
    background-color: #361769;
    decorator: image(../ui-stars-tile.png repeat), linear-gradient(180deg, rgba(91, 47, 176, 94%) 0%, rgba(54, 23, 105, 94%) 55%, rgba(36, 16, 74, 96%) 100%);
}

@media (max-height: 800dp) {
    .tuner-root {
        min-height: 38%;
    }

    .tuner {
        gap: 16dp;
        padding: 20dp 32dp;
        margin-bottom: 12dp;
    }
}

.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24dp;
}

.carousel-container {
    flex: 1 1 auto;
    display: flex;
    justify-content: flex-end;
    min-width: 0;
}

#title {
    font-weight: bold;
    color: #FFFFFF;
    font-effect: outline(2dp #4A1C00);
}

.description {
    font-size: 15dp;
    line-height: 22dp;
    color: rgba(241, 234, 255, 80%);
}

.divider {
    margin: 1dp 0;
    border-top: 3dp rgba(216, 205, 245, 30%);
}

.footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24dp;
}

footer-button {
    display: block;
    width: 100%;
    max-width: 220dp;
    border: 0;
    padding: 0;
    background-color: transparent;
    font-family: "Fredoka";
    font-weight: bold;
    font-size: 16dp;
    line-height: 24dp;
    text-transform: uppercase;
    color: #FFFFFF;
    opacity: 1;
    cursor: pointer;
}

footer-button:hover,
footer-button:focus-visible {
    color: #FFD23F;
}

footer-button.return {
    text-align: left;
}

footer-button.reset {
    text-align: right;
}

.stepped-carousel {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16dp;
    width: auto;
    min-width: 246dp;
    padding: 0;
    background-color: transparent;
    font-family: "Fredoka";
    font-weight: bold;
}

.stepped-carousel-value {
    line-height: 29dp;
    min-width: 166dp;
    text-align: center;
    white-space: nowrap;
    color: #FFE066;
    font-effect: outline(2dp #4A1C00);
}

.stepped-carousel-arrow {
    width: 32dp;
    height: 32dp;
    min-width: 32dp;
    font-size: 30dp;
    padding: 0;
    border: 0;
    background-color: transparent;
    opacity: 1;
    cursor: pointer;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    color: #FFD23F;
}
