tab-bar {
    display: flex;
    align-items: center;
    position: relative;
    min-width: 0;
    overflow: auto hidden;
    clip: always;
    text-transform: uppercase;
}

tab-bar scrollbarhorizontal,
tab-bar scrollbarhorizontal sliderarrowdec,
tab-bar scrollbarhorizontal sliderarrowinc,
tab-bar scrollbarhorizontal slidertrack,
tab-bar scrollbarhorizontal sliderbar {
    width: 0;
    height: 0;
}

/* Pill tabs. Unselected: soft lavender; selected: MP5 orange title banner; focus: yellow glow. */
tab-bar tab {
    flex: 0 0 auto;
    margin: 0 4dp;
    padding: 0 20dp;
    line-height: 38dp;
    white-space: nowrap;
    border-radius: 22dp;
    border: 3dp rgba(216, 205, 245, 25%);
    background-color: rgba(255, 255, 255, 6%);
    color: rgba(241, 234, 255, 70%);
    transform: scale(1);
    transition: transform 0.22s back-out, color 0.1s linear-in-out;
    cursor: pointer;
}

tab-bar tab:selected {
    color: #FFFFFF;
    border-color: #8A3F08;
    decorator: linear-gradient(180deg, #FFEDB5 0%, #F6BD5C 55%, #E48A2A 100%);
    font-effect: outline(2dp #8A3F08);
}

tab-bar tab:focus-visible,
tab-bar tab:hover {
    color: #4A1C00;
    border-color: #FFFFFF;
    decorator: linear-gradient(180deg, #FFF8B0 0%, #FFD23A 55%, #FFA51E 100%);
    box-shadow: rgba(255, 200, 40, 60%) 0 0 12dp 2dp;
    font-effect: none;
    transform: scale(1.06);
}

tab-bar tab:active {
    decorator: linear-gradient(180deg, #FFD23A 0%, #FF9D14 100%);
    transform: scale(0.97);
}

tab-bar[closable] tab-end-spacer {
    display: block;
    flex: 0 0 64dp;
    width: 64dp;
    pointer-events: none;
}

/* Round red "B" style close button with a cream rim */
tab-bar[closable] close {
    display: block;
    position: fixed;
    top: 12dp;
    right: 12dp;
    z-index: 1;
    width: 44dp;
    height: 44dp;
    font-family: "Material Symbols Rounded";
    font-weight: normal;
    font-size: 24dp;
    color: #FFFFFF;
    border: 3dp #FFF3D0;
    border-radius: 22dp;
    decorator: text("&#xe5cd;" center center), linear-gradient(180deg, #FF8A7A 0%, #E8323A 60%, #B81828 100%);
    transform: scale(1);
    transition: transform 0.22s back-out;
    cursor: pointer;
}

tab-bar[closable] close:hover,
tab-bar[closable] close:focus-visible {
    border-color: #FFFFFF;
    box-shadow: rgba(255, 200, 40, 70%) 0 0 12dp 3dp;
    transform: scale(1.1);
}

tab-bar[closable] close:active {
    transform: scale(0.95);
}
