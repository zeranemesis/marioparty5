+// MP5: Scale2x (AdvMAME2x) with a colour tolerance, so it also finds the edges of non pixel-art textures: each texel
+// becomes 2x2, its corners taking the colour of two matching neighbours across a diagonal edge, else interpolated.
+bool similar(const u8* a, const u8* b, uint32_t bpp) {
+  for (uint32_t c = 0; c < bpp; ++c) {
+    if (std::abs(int{a[c]} - int{b[c]}) > 24) {
+      return false;
+    }
+  }
+  return true;
