+// Games that re-init their GXTexObj before every draw (a new texObjId each time) never hit the cache above, so
+// every draw re-converted and re-uploaded its texture. Key on the bytes instead: correct even when the game rewrites
+// a texture in place, and hashing is far cheaper than converting.
+// shortcut: flushed wholesale past a cap, no per-entry lifetime tracking.
+absl::flat_hash_map<u64, gfx::TextureHandle> s_contentTextures;
+
+std::optional<u64> content_texture_key(const GXTexObj_& obj, const GXTlutObj_* tlut) {
+  if (obj.data == nullptr || obj.format() > GX_TF_CMPR || obj.no_cache() || (tlut != nullptr && tlut->no_cache())) {
+    return std::nullopt;
+  }
+  const u32 mips = obj.mip_count();
+  const u32 size = GXGetTexBufferSize(obj.width(), obj.height(), obj.format(), mips > 1, mips);
+  u64 key = XXH3_64bits_withSeed(obj.data, size,
+                                 (u64{obj.width()} << 40) | (u64{obj.height()} << 16) | (u64{mips} << 8) | obj.format());
+  if (tlut != nullptr) {
+    key = XXH3_64bits_withSeed(tlut->data, size_t{tlut->numEntries} * 2, key ^ (static_cast<u64>(tlut->format) + 1));
+  }
+  return key;
+}
