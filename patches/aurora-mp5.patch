+TextureHandle new_upscaled_texture_2d(uint32_t width, uint32_t height, uint32_t mips, u32 format,
+                                      ArrayRef<uint8_t> data, const char* label) noexcept {
+  const uint32_t factor = g_config.textureUpscale;
+  if (factor != 2 && factor != 4) {
+    return {};
+  }
+  const uint32_t levels = factor == 4 ? 2 : 1; // extra mip levels above the original chain
+  if (width * factor > 2048 || height * factor > 2048) {
+    return {};
+  }
+  uint32_t bpp = 0;
+  switch (to_wgpu(format)) {
+  case wgpu::TextureFormat::R8Unorm: bpp = 1; break;
+  case wgpu::TextureFormat::RG8Unorm: bpp = 2; break;
+  case wgpu::TextureFormat::RGBA8Unorm: bpp = 4; break;
+  default: return {}; // block-compressed, depth, ...
+  }
+  ZoneScoped;
+  ConvertedTexture converted = convert_texture(format, width, height, mips, data);
+  if (converted.hasArbitraryMips) {
+    return {}; // the LOD bias of mips that differ from their base assumes the original size
+  }
+  const u8* base = converted.data.empty() ? data.data() : converted.data.data();
+  size_t originalBytes = 0;
+  for (uint32_t mip = 0; mip < mips; ++mip) {
+    originalBytes += size_t{std::max(width >> mip, 1u)} * std::max(height >> mip, 1u) * bpp;
+  }
+  // the scaled levels on top, then the game's own chain unchanged: minified, the texture samples as before
+  std::vector<u8> x2 = scale2x(base, width, height, bpp);
+  std::vector<u8> chain;
+  if (levels == 2) {
+    chain = scale2x(x2.data(), width * 2, height * 2, bpp);
+  }
+  chain.insert(chain.end(), x2.begin(), x2.end());
+  chain.insert(chain.end(), base, base + originalBytes);
+
+  auto handle = new_dynamic_texture_2d(width * factor, height * factor, mips + levels, format, label);
+  handle->upscaleLevels = levels;
+  upload_mips(*handle, mips + levels, {chain.data(), chain.size()}, label);
   return handle;
 }
 
