diff --git a/lib/gfx/copy_readback.cpp b/lib/gfx/copy_readback.cpp
new file mode 100644
index 0000000..eba53b6
--- /dev/null
+++ b/lib/gfx/copy_readback.cpp
@@ -0,0 +1,216 @@
+#include "copy_readback.hpp"
+
+#include "texture.hpp"
+#include "../webgpu/gpu.hpp"
+
+#include <absl/container/flat_hash_map.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+namespace aurora::gfx::copy_readback {
+namespace {
+Module Log("aurora::gfx::copy_readback");
+
+using webgpu::g_device;
+using webgpu::g_instance;
+
+enum class State : int { Created, Encoded, Mapping, Done, Failed };
+} // namespace
+
+struct Request {
+  void* dest = nullptr;
+  uint32_t logicalWidth = 0;
+  uint32_t logicalHeight = 0;
+  GXTexFmt format = GX_TF_RGBA8;
+  bool efbHasAlpha = false;
+  TextureHandle texture;
+  wgpu::Buffer buffer;
+  uint32_t bytesPerRow = 0;
+  uint64_t byteSize = 0;
+  std::atomic<State> state{State::Created};
+  std::vector<uint8_t> pixels; // mapped copy, bytesPerRow * texture height
+};
+
+namespace {
+std::mutex g_mutex;
+absl::flat_hash_map<void*, RequestPtr> g_latest; // per destination, the most recent copy
+std::vector<RequestPtr> g_encoded;              // encoded this frame, mapped after submit
+
+void complete(const RequestPtr& req, wgpu::MapAsyncStatus status) {
+  if (status == wgpu::MapAsyncStatus::Success) {
+    const auto* src = static_cast<const uint8_t*>(req->buffer.GetConstMappedRange(0, req->byteSize));
+    req->pixels.assign(src, src + req->byteSize);
+    req->buffer.Unmap();
+    req->state = State::Done;
+  } else {
+    req->state = State::Failed;
+  }
+}
+
+// texel (x, y) of the logical-size copy, sampled from the (possibly upscaled) resolved texture, as RGBA8
+void texel(const Request& req, uint32_t x, uint32_t y, uint8_t out[4]) {
+  const uint32_t w = req.texture->size.width;
+  const uint32_t h = req.texture->size.height;
+  const uint32_t sx = std::min(w - 1, ((2 * x + 1) * w) / (2 * req.logicalWidth));
+  const uint32_t sy = std::min(h - 1, ((2 * y + 1) * h) / (2 * req.logicalHeight));
+  const uint8_t* p = req.pixels.data() + static_cast<size_t>(sy) * req.bytesPerRow + static_cast<size_t>(sx) * 4;
+  const bool bgra = req.texture->format == wgpu::TextureFormat::BGRA8Unorm ||
+                    req.texture->format == wgpu::TextureFormat::BGRA8UnormSrgb;
+  out[0] = bgra ? p[2] : p[0];
+  out[1] = p[1];
+  out[2] = bgra ? p[0] : p[2];
+  out[3] = req.efbHasAlpha ? p[3] : 0xFF; // an RGB8 or RGB565 EFB copies alpha as opaque
+}
+
+void put16(uint8_t* d, uint16_t v) {
+  d[0] = static_cast<uint8_t>(v >> 8);
+  d[1] = static_cast<uint8_t>(v);
+}
+
+uint16_t rgb5a3(const uint8_t c[4]) {
+  if (c[3] >= 0xE0) {
+    return 0x8000 | ((c[0] >> 3) << 10) | ((c[1] >> 3) << 5) | (c[2] >> 3);
+  }
+  return ((c[3] >> 5) << 12) | ((c[0] >> 4) << 8) | ((c[1] >> 4) << 4) | (c[2] >> 4);
+}
+
+// GameCube tiled layout: 4x4 texel blocks, row-major, big-endian
+bool write_gc(const Request& req) {
+  auto* dst = static_cast<uint8_t*>(req.dest);
+  const uint32_t w = req.logicalWidth;
+  const uint32_t h = req.logicalHeight;
+  uint8_t c[4];
+  switch (req.format) {
+  case GX_TF_RGB5A3:
+  case GX_TF_RGB565:
+    for (uint32_t by = 0; by < h; by += 4) {
+      for (uint32_t bx = 0; bx < w; bx += 4) {
+        for (uint32_t y = by; y < by + 4; y++) {
+          for (uint32_t x = bx; x < bx + 4; x++, dst += 2) {
+            if (x >= w || y >= h) {
+              put16(dst, 0);
+              continue;
+            }
+            texel(req, x, y, c);
+            put16(dst, req.format == GX_TF_RGB5A3
+                           ? rgb5a3(c)
+                           : static_cast<uint16_t>(((c[0] >> 3) << 11) | ((c[1] >> 2) << 5) | (c[2] >> 3)));
+          }
+        }
+      }
+    }
+    return true;
+  case GX_TF_RGBA8:
+    for (uint32_t by = 0; by < h; by += 4) {
+      for (uint32_t bx = 0; bx < w; bx += 4) {
+        uint8_t* ar = dst;
+        uint8_t* gb = dst + 32;
+        for (uint32_t y = by; y < by + 4; y++) {
+          for (uint32_t x = bx; x < bx + 4; x++, ar += 2, gb += 2) {
+            if (x >= w || y >= h) {
+              c[0] = c[1] = c[2] = c[3] = 0;
+            } else {
+              texel(req, x, y, c);
+            }
+            ar[0] = c[3];
+            ar[1] = c[0];
+            gb[0] = c[1];
+            gb[1] = c[2];
+          }
+        }
+        dst += 64;
+      }
+    }
+    return true;
+  default:
+    Log.warn("copy readback: format {} not encoded", static_cast<int>(req.format));
+    return false;
+  }
+}
+} // namespace
+
+RequestPtr create(void* dest, uint32_t logicalWidth, uint32_t logicalHeight, GXTexFmt format, bool efbHasAlpha,
+                  const TextureHandle& texture) {
+  auto req = std::make_shared<Request>();
+  req->dest = dest;
+  req->logicalWidth = logicalWidth;
+  req->logicalHeight = logicalHeight;
+  req->format = format;
+  req->efbHasAlpha = efbHasAlpha;
+  req->texture = texture;
+  req->bytesPerRow = (texture->size.width * 4 + 255) & ~255u;
+  req->byteSize = static_cast<uint64_t>(req->bytesPerRow) * texture->size.height;
+  const wgpu::BufferDescriptor desc{
+      .label = "Copy Readback Buffer",
+      .usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst,
+      .size = req->byteSize,
+  };
+  req->buffer = g_device.CreateBuffer(&desc);
+  std::lock_guard lock{g_mutex};
+  g_latest[dest] = req;
+  return req;
+}
+
+void encode(const wgpu::CommandEncoder& cmd, const RequestPtr& req) noexcept {
+  const wgpu::TexelCopyTextureInfo src{.texture = req->texture->texture};
+  const wgpu::TexelCopyBufferInfo dst{
+      .layout = {.offset = 0, .bytesPerRow = req->bytesPerRow, .rowsPerImage = req->texture->size.height},
+      .buffer = req->buffer,
+  };
+  const wgpu::Extent3D size{.width = req->texture->size.width, .height = req->texture->size.height,
+                            .depthOrArrayLayers = 1};
+  cmd.CopyTextureToBuffer(&src, &dst, &size);
+  req->state = State::Encoded;
+  std::lock_guard lock{g_mutex};
+  g_encoded.push_back(req);
+}
+
+void after_submit() noexcept {
+  std::vector<RequestPtr> pending;
+  {
+    std::lock_guard lock{g_mutex};
+    pending.swap(g_encoded);
+  }
+  for (auto& req : pending) {
+    req->state = State::Mapping;
+    req->buffer.MapAsync(wgpu::MapMode::Read, 0, req->byteSize, wgpu::CallbackMode::AllowSpontaneous,
+                         [req](wgpu::MapAsyncStatus status, wgpu::StringView) { complete(req, status); });
+  }
+}
+
+bool sync(void* dest) noexcept {
+  RequestPtr req;
+  {
+    std::lock_guard lock{g_mutex};
+    const auto it = g_latest.find(dest);
+    if (it == g_latest.end()) {
+      return false;
+    }
+    req = it->second;
+  }
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds{2};
+  while (req->state != State::Done && req->state != State::Failed) {
+    if (std::chrono::steady_clock::now() > deadline) {
+      Log.warn("copy readback of {} timed out", dest);
+      return false;
+    }
+    g_instance.ProcessEvents();
+    std::this_thread::yield();
+  }
+  if (req->state == State::Failed) {
+    return false;
+  }
+  {
+    std::lock_guard lock{g_mutex};
+    if (g_latest[dest] == req) {
+      g_latest.erase(dest); // written once; a later copy makes a new request
+    }
+  }
+  return write_gc(*req);
+}
+} // namespace aurora::gfx::copy_readback
