+
+std::vector<u8> scale2x(const u8* src, uint32_t w, uint32_t h, uint32_t bpp) {
+  std::vector<u8> dst(size_t{w} * h * 4 * bpp);
+  const auto at = [&](int x, int y) {
+    x = std::clamp(x, 0, int(w) - 1), y = std::clamp(y, 0, int(h) - 1);
+    return src + (size_t(y) * w + x) * bpp;
+  };
+  for (int y = 0; y < int(h); ++y) {
+    for (int x = 0; x < int(w); ++x) {
+      const u8 *e = at(x, y), *b = at(x, y - 1), *d = at(x - 1, y), *f = at(x + 1, y), *hh = at(x, y + 1);
+      // corners: top-left (b,d), top-right (b,f), bottom-left (hh,d), bottom-right (hh,f)
+      const u8* pairs[4][2] = {{b, d}, {b, f}, {hh, d}, {hh, f}};
+      const u8* opposite[4][2] = {{f, hh}, {d, hh}, {f, b}, {d, b}};
+      const u8* diagonal[4] = {at(x - 1, y - 1), at(x + 1, y - 1), at(x - 1, y + 1), at(x + 1, y + 1)};
+      for (int i = 0; i < 4; ++i) {
+        u8* out = dst.data() + ((size_t(y) * 2 + (i >> 1)) * w * 2 + size_t(x) * 2 + (i & 1)) * bpp;
+        const u8 *p = pairs[i][0], *q = pairs[i][1], *g = diagonal[i];
+        const bool edge = similar(p, q, bpp) && !similar(p, opposite[i][0], bpp) && !similar(q, opposite[i][1], bpp);
+        for (uint32_t c = 0; c < bpp; ++c) {
+          // off an edge: the bilinear sample at this quarter texel, so smooth areas look as they did
+          out[c] = edge ? u8((p[c] + q[c] + 1) / 2) : u8((9 * e[c] + 3 * (p[c] + q[c]) + g[c] + 8) / 16);
+        }
+      }
+    }
+  }
+  return dst;
+}
+
+} // namespace
