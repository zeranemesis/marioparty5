+#pragma once
+
+#include "common.hpp"
+
+#include <dolphin/gx/GXEnum.h>
+
+#include <memory>
+
+// EFB copies written back to main memory, for games that read or edit a GXCopyTex destination on the CPU
+// (MP5 m505 turns the copied penguin's opaque black into transparent texels). Opt-in per copy
+// (AuroraGXSetCopyReadback): the resolved texture is copied into a buffer in the same frame, mapped after submit,
+// and AuroraGXCopyReadbackSync re-encodes it in the GameCube texture layout at the copy destination.
+namespace aurora::gfx::copy_readback {
+struct Request;
+using RequestPtr = std::shared_ptr<Request>;
+
+// main thread, inside GXCopyTex: a readback of `texture` once the resolve pass ran
+RequestPtr create(void* dest, uint32_t logicalWidth, uint32_t logicalHeight, GXTexFmt format, bool efbHasAlpha,
+                  const TextureHandle& texture);
+// render worker, right after the resolve pass of the request's pass
+void encode(const wgpu::CommandEncoder& cmd, const RequestPtr& request) noexcept;
+// render worker, after the frame's queue submit
+void after_submit() noexcept;
+// main thread: waits for the latest readback of dest and writes it there; false if none or it failed
+bool sync(void* dest) noexcept;
+} // namespace aurora::gfx::copy_readback
