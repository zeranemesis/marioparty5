-    if (SDL_GetAtomicInt(&paused) || queued >= bytes * 8) {
-      SDL_Delay(1);
+    if (SDL_GetAtomicInt(&paused)) {
+      SDL_Delay(5);
+      continue;
+    }
+    if (queued >= bytes * 8) {
+      /* Sleep until about 30 ms are left (a batch is 5 ms) rather than polling every millisecond: a thousand
+       * wake-ups a second kept the cores out of their deep idle states. */
+      Uint32 ms = (Uint32)((queued - bytes * 6) * 5 / bytes);
+      SDL_Delay(ms < 1 ? 1 : ms > 20 ? 20 : ms);
       continue;
     }
     hwIRQEnterCritical();
