#ifndef VERSION_H
#define VERSION_H

#define MP5_NATIVE_WC_DESCRIBE "@MP5_NATIVE_WC_DESCRIBE@"
#define MP5_NATIVE_VERSION_STRING "@MP5_NATIVE_VERSION_STRING@"

#define MP5_NATIVE_WC_BRANCH "@MP5_NATIVE_WC_BRANCH@"
#define MP5_NATIVE_WC_REVISION "@MP5_NATIVE_WC_REVISION@"
#define MP5_NATIVE_WC_DATE "@MP5_NATIVE_WC_DATE@"
#define MP5_NATIVE_BUILD_TYPE "@CMAKE_BUILD_TYPE@"

#if defined(__x86_64__) || defined(_M_AMD64)
#define MP5_NATIVE_ARCH "x86_64"
#elif defined(__i386__) || defined(_M_IX86)
#define MP5_NATIVE_ARCH "x86"
#elif defined(__aarch64__) || defined(_M_ARM64)
#define MP5_NATIVE_ARCH "arm64"
#endif

#define MP5_NATIVE_PLATFORM_NAME "@PLATFORM_NAME@"
#define MP5_NATIVE_DLPACKAGE "mp5native-@MP5_NATIVE_WC_DESCRIBE@-" MP5_NATIVE_PLATFORM_NAME "-" MP5_NATIVE_ARCH

#define MP5_NATIVE_SENTRY_DSN "@MP5_NATIVE_SENTRY_DSN@"
#define MP5_NATIVE_SENTRY_ENVIRONMENT "@MP5_NATIVE_SENTRY_ENVIRONMENT@"

#endif
