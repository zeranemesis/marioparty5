#include <windows.h>
#include <winver.h>

IDI_MAIN_ICON ICON "@MP5_NATIVE_WINDOWS_ICON_ICO@"
1 RT_MANIFEST "@MP5_NATIVE_WINDOWS_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "@MP5_NATIVE_COMPANY_NAME@\0"
            VALUE "FileDescription", "@MP5_NATIVE_FILE_DESCRIPTION@\0"
            VALUE "FileVersion", "@MP5_NATIVE_VERSION_STRING@\0"
            VALUE "InternalName", "mp5native\0"
            VALUE "LegalCopyright", "@MP5_NATIVE_COPYRIGHT@\0"
            VALUE "OriginalFilename", "mp5native.exe\0"
            VALUE "ProductName", "@MP5_NATIVE_PRODUCT_NAME@\0"
            VALUE "ProductVersion", "@MP5_NATIVE_VERSION_STRING@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
